{
  "name": "curehht.github.io",
  "private": true,
  "description": "Cure HHT russian-speaking user group",
  "version": "3.0.0",
  "author": "Alex Baumgertner <alex.baumgertner@gmail.com>",
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/drizzle-adapter": "^1.11.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.10.0",
    "@tinymce/tinymce-react": "^6.3.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev-debug": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "build:local": "NODE_ENV=development next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "drizzle-studio": "drizzle-kit studio",
    "prepare": "husky",
    "lint-staged": "lint-staged --verbose",
    "migration:generate": "drizzle-kit generate",
    "migration:migrate": "drizzle-kit migrate",
    "migration:repair-state": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/repair-migration-state.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/curehht/curehht.github.io"
  },
  "bugs": {
    "url": "https://github.com/curehht/curehht.github.io/issues"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
